{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "npm run build *": "allow",
      "npx *": "allow",
      "Select-Object *": "allow",
      "*": "allow"
    },
    "external_directory": {
      "C:\\NewWaveProjetos\\newbarbe\\.kilo\\*": "allow"
    }
  },
  "indexing": {
    "enabled": true
  },
  "experimental": {
    "batch_tool": true,
    "openTelemetry": true,
    "codebase_search": true,
    "native_notebook_tools": true,
    "image_generation": true
  },
  "auto_collapse_reasoning": false,
  "terminal_command_display": "expanded",
  "instructions": [
    "voce sempre vai ler todos os arquivos md e vai executar o que falta deles ve onde parou se atualizou iniciou um novo chat leia os arquivos"
  ]
}